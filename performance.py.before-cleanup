
import sqlite3
from datetime import datetime, timezone

DATABASE = "airwatch.db"


def initialize_performance_db():
    connection = sqlite3.connect(DATABASE)

    try:
        connection.execute("""
            CREATE TABLE IF NOT EXISTS performance_metrics (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                recorded_at TEXT NOT NULL,
                processing_latency_ms REAL NOT NULL,
                was_duplicate INTEGER NOT NULL,
                quality_status TEXT NOT NULL,
                producer_to_consumer_latency_ms REAL
            )
        """)

        # Safely upgrade an existing performance table
        columns = {
            row[1]
            for row in connection.execute(
                "PRAGMA table_info(performance_metrics)"
            ).fetchall()
        }

        if "producer_to_consumer_latency_ms" not in columns:
            connection.execute("""
                ALTER TABLE performance_metrics
                ADD COLUMN producer_to_consumer_latency_ms REAL
            """)

        connection.execute("""
            CREATE INDEX IF NOT EXISTS
            idx_performance_recorded_at
            ON performance_metrics(recorded_at)
        """)

        connection.commit()

    finally:
        connection.close()


def record_performance(
    latency_ms,
    was_duplicate,
    quality_status,
    producer_to_consumer_latency_ms=None
):
    connection = sqlite3.connect(DATABASE)

    try:
        connection.execute("""
            INSERT INTO performance_metrics (
                recorded_at,
                processing_latency_ms,
                was_duplicate,
                quality_status,
                producer_to_consumer_latency_ms
            )
            VALUES (?, ?, ?, ?, ?)
        """, (
            datetime.now(timezone.utc).isoformat(),
            float(latency_ms),
            int(was_duplicate),
            quality_status,
            (
                float(producer_to_consumer_latency_ms)
                if producer_to_consumer_latency_ms is not None
                else None
            )
        ))

        connection.commit()

    finally:
        connection.close()
